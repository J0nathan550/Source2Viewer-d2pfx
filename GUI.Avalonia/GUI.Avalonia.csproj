<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RollForward>LatestMajor</RollForward>
    <Description>Cross-platform Source 2 resource viewer</Description>
    <ApplicationIcon>..\Misc\Icons\source2viewer.ico</ApplicationIcon>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
    <StartupObject>GUI.Program</StartupObject>
    <AssemblyName>Source2Viewer.Avalonia</AssemblyName>
    <!-- Shared GUI sources are compiled here unmodified, so keep their namespaces and resource names -->
    <RootNamespace>GUI</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <!-- Only the platform neutral decoders, output goes through OpenAL -->
    <PackageReference Include="NAudio.Core" Version="3.1.0" />
    <PackageReference Include="NLayer" Version="3.0.0" />
    <PackageReference Include="NLayer.NAudioSupport" Version="3.0.0" />
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <!-- Verifies the build provenance of downloaded updates, like the WinForms GUI -->
    <PackageReference Include="Sigstore" Version="1.0.1" />
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <!-- Avalonia brings the Linux native library of an older SkiaSharp, which the newer SkiaSharp used by
         ValveResourceFormat refuses to load, so the native library has to match that SkiaSharp version -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.151.2" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CustomVmdlExtractor\VmdlExtractor\VmdlExtractor.csproj" />
    <ProjectReference Include="..\Renderer\Renderer.csproj" />
    <ProjectReference Include="..\ValveResourceFormat\ValveResourceFormat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="ValveResourceFormat.Utils" />
    <Using Include="ValveResourceFormat.CompiledShader" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\GUI\Utils\industrial_sunset_puresky.vtex_c" LogicalName="GUI.Utils.industrial_sunset_puresky.vtex_c" />
    <EmbeddedResource Include="..\THIRD_PARTY_NOTICES.txt" LogicalName="GUI.Utils.THIRD_PARTY_NOTICES.txt" />
    <EmbeddedResource Include="..\Misc\Icons\vpk.ico" LogicalName="GUI.Utils.vpk.ico" />
    <!-- Named GUI.Icons.* like in the WinForms GUI, the node graph renderer loads its icons by those names -->
    <EmbeddedResource Include="..\GUI\Icons\**" Link="Icons\%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\Misc\Icons\source2viewer.ico" Link="Assets\source2viewer.ico" />
  </ItemGroup>

  <!--
    UI-agnostic sources shared with the WinForms GUI. They are compiled in place so both front-ends
    run the same viewer logic. Anything they need from the UI layer (settings dialogs, the viewer
    sidebar, input types) is provided by this project under the same names. See README.md.
  -->
  <ItemGroup>
    <Compile Include="..\GUI\Utils\AssertTraceListener.cs" Link="Shared\Utils\%(Filename)%(Extension)" />
