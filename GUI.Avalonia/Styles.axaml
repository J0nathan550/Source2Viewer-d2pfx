<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource S2vAppBrush}" />
    </Style>

    <Style Selector="Border.statusBar">
        <Setter Property="Background" Value="{DynamicResource S2vAppMiddleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource S2vBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <Style Selector="Border.statusBar TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource S2vContrastSoftBrush}" />
    </Style>

    <Style Selector="Border.toolbar">
        <Setter Property="Background" Value="{DynamicResource S2vAppMiddleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource S2vBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style Selector="Button.flat">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,4" />
    </Style>

    <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource S2vHoverAccentBrush}" />
    </Style>

    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource S2vBorderBrush}" />
    </Style>

    <!-- Top bar: logo and menu over the app background, in the title bar like the WinForms custom frame -->
    <Style Selector="DockPanel.topBar">
        <Setter Property="Background" Value="{DynamicResource S2vAppBrush}" />
    </Style>

    <Style Selector="Menu.main">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="32" />
    </Style>

    <!-- Menu items are square and outlined in the accent color while hovered, like the WinForms menus -->
    <Style Selector="MenuItem">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="MenuItem:selected">
        <Setter Property="BorderBrush" Value="{DynamicResource S2vAccentBrush}" />
    </Style>

    <Style Selector="Menu.main > MenuItem">
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- Menu icons are 24 pixels like the WinForms ImageScalingSize, the theme shrinks them to 16 -->
    <Style Selector="MenuItem /template/ ContentControl#PART_IconPresenter">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
    </Style>

    <Style Selector="ContextMenu Separator, MenuItem Separator">
        <Setter Property="Background" Value="{DynamicResource S2vBorderBrush}" />
    </Style>

    <!--
        Main tabs: the strip is the app background and the page below it is lifted to AppMiddle.
        Tabs only show their header, which draws the selected and hovered shapes itself (MainTabHeader).
    -->
    <Style Selector="TabControl.main">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource S2vAppBrush}" />
    </Style>

    <Style Selector="TabControl.main[TabStripPlacement=Top] /template/ ItemsPresenter#PART_ItemsPresenter">
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="TabControl.main /template/ ContentPresenter#PART_SelectedContentHost, TabControl.main /template/ ContentPresenter#PART_SelectedContentHost2">
        <Setter Property="Background" Value="{DynamicResource S2vAppMiddleBrush}" />
    </Style>

    <Style Selector="TabControl.main > TabItem">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <ControlTemplate TargetType="TabItem">
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="Transparent"
                                  Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Stretch" />
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Package previews host a single tab without a header -->
    <Style Selector="TabControl.preview /template/ ItemsPresenter#PART_ItemsPresenter">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="TextBox.pathBox">
        <Setter Property="Background" Value="{DynamicResource S2vAppMiddleBrush}" />
        <Setter Property="MinHeight" Value="23" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- Flat like the WinForms text boxes: no rounded corners, and no border or color change on hover and focus -->
    <Style Selector="TextBox.pathBox:pointerover /template/ Border#PART_BorderElement, TextBox.pathBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource S2vAppMiddleBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="ScrollViewer.page">
        <Setter Property="Background" Value="{DynamicResource S2vAppMiddleBrush}" />
    </Style>

    <!-- Group box titles sit in the frame's top line, in the text color like the WinForms ThemedGroupBox -->
    <Style Selector="Grid.groupBox > TextBlock.groupHeader">
        <Setter Property="Foreground" Value="{DynamicResource S2vContrastBrush}" />
        <Setter Property="Padding" Value="2,0" />
    </Style>

    <!-- Square inputs outlined like the WinForms ones, over the background of what they are in -->
    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource S2vButtonBorderBrush}" />
    </Style>

    <Style Selector="TextBox, NumericUpDown, AutoCompleteBox">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="BorderBrush" Value="{DynamicResource S2vButtonBorderBrush}" />
    </Style>

    <Style Selector="Border.keycap">
        <Setter Property="BorderBrush" Value="{DynamicResource S2vBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource S2vAppSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="4,1" />
    </Style>

    <Style Selector="Button.highlighted">
        <Setter Property="Foreground" Value="{DynamicResource S2vAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TreeView.explorer TreeViewItem">
        <Setter Property="MinHeight" Value="26" />
    </Style>

    <Style Selector="ListBox.packageGrid ListBoxItem">
        <Setter Property="Padding" Value="2" />
    </Style>

    <Style Selector="TabControl.content > TabItem">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="10,2" />
    </Style>

    <Style Selector="StackPanel.sidebar TextBlock.groupHeader">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,8,0,2" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>

    <Style Selector="StackPanel.sidebar > :is(Control)">
        <Setter Property="Margin" Value="0,2" />
    </Style>

    <Style Selector="ComboBoxItem.header">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="IsEnabled" Value="False" />
    </Style>

    <!-- The main window shows its title in the status bar, the logo and menu take the title bar's place -->
    <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel">
        <Setter Property="Opacity" Value="0" />
    </Style>

    <!-- No fullscreen button among the window buttons, the WinForms title bar has none -->
    <Style Selector="WindowDrawnDecorations:has-fullscreen /template/ Button#PART_FullScreenButton">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Searchable combo box: a search box over the list of items, in a popup -->
    <Style Selector="Border.searchPopup">
        <Setter Property="Background" Value="{DynamicResource S2vAppMiddleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource S2vBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Border.searchHeader">
        <Setter Property="BorderBrush" Value="{DynamicResource S2vBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style Selector="ListBox.searchList">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBox.searchList ListBoxItem">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Divider between a preview and its controls, with a grip in its middle to show it can be dragged -->
    <Style Selector="Border.gripLine">
        <Setter Property="Background" Value="{DynamicResource S2vBorderBrush}" />
    </Style>

    <Style Selector="Ellipse.grip">
        <Setter Property="Fill" Value="{DynamicResource S2vContrastBrush}" />
    </Style>

    <!-- Package browser, colored and spaced like the WinForms TreeViewWithSearchResults -->
    <Style Selector="TreeView.packageTree">
        <Setter Property="Background" Value="{DynamicResource S2vAppMiddleBrush}" />
    </Style>

    <Style Selector="GridSplitter.packageSplitter">
        <Setter Property="Background" Value="{DynamicResource S2vAppMiddleBrush}" />
        <Setter Property="MinWidth" Value="0" />
    </Style>

    <Style Selector="Border.packageToolbar">
        <Setter Property="Background" Value="{DynamicResource S2vAppSoftBrush}" />
    </Style>

    <Style Selector="Button.navigation">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="3,4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Small round radio buttons, like the native WinForms ones -->
    <Style Selector="RadioButton.small">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="2,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="RadioButton.small /template/ Ellipse#OuterEllipse, RadioButton.small /template/ Ellipse#CheckOuterEllipse">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>

    <Style Selector="RadioButton.small /template/ Ellipse#CheckGlyph">
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="6" />
    </Style>

    <Style Selector="ListBox.packageList">
        <Setter Property="Background" Value="{DynamicResource S2vAppSoftBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="ListBox.packageList ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="25" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

    <!-- Column headers drawn like the WinForms BetterListView: a line under them and between the columns -->
    <Style Selector="Border.listHeader">
        <Setter Property="Background" Value="{DynamicResource S2vAppSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource S2vBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style Selector="Border.listHeaderCell, Border.listHeaderLastCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource S2vBorderBrush}" />
    </Style>

    <Style Selector="Border.listHeaderCell">
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <Style Selector="Border.listHeaderCell:pointerover, Border.listHeaderLastCell:pointerover">
        <Setter Property="Background" Value="{DynamicResource S2vAppMiddleBrush}" />
    </Style>

    <!-- Settings: the WinForms footer is drawn in the inactive caption system color -->
    <Style Selector="ScrollViewer.settings TextBlock.settingsFooter">
        <Setter Property="Foreground" Value="#BFCDDB" />
    </Style>

    <Style Selector="ListBox.settingsList">
        <Setter Property="Background" Value="{DynamicResource S2vAppMiddleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource S2vButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="NumericUpDown.settings, ComboBox.settings">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="CheckBox.settings">
        <Setter Property="MinHeight" Value="0" />
    </Style>
</Styles>
